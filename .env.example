# ============================================================================
# CEBP Project — Environment Configuration Template
# Copy to `.env` if you want to provide live API keys.
# All services work out-of-the-box with built-in replay/keyless streams when blank!
# ============================================================================

# --- Infrastructure ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=core_db
POSTGRES_USER=cebp
POSTGRES_PASSWORD=cebp_secret

# --- Member 1: Public Transit Data Sources ---
# Transport for NSW (Sydney) - Initial Scope (https://opendata.transport.nsw.gov.au/developers/api-basics)
# Header format used automatically: `Authorization: apikey <TFNSW_API_KEY>`
# If left empty, Core Management Service automatically uses the deterministic Sydney Replay Fallback.
TFNSW_API_KEY=

# Transport for London (TfL) - Keyless by default (optional app_key for higher rate limits)
TFL_APP_KEY=

# Helsinki Regional Transport (HSL) - Keyless public MQTT broker
HSL_MQTT_BROKER_URL=tcp://mqtt.hsl.fi:1883

# NYC MTA - Subway GTFS-RT feeds are keyless; optional key for Bus Time API
MTA_API_KEY=

# --- Member 4: AI Agent & Remote MCP Server ---
# Optional Google Gemini Free Tier API key. If empty, AutonomousTransitOpsAgent uses its deterministic reasoning engine.
GEMINI_API_KEY=
