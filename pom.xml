<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.3</version>
        <relativePath/>
    </parent>

    <groupId>ro.upb.cebp</groupId>
    <artifactId>cebp-platform-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>CEBP Distributed Public Transit Analytics Platform</name>
    <description>A Distributed Data Analytics Platform with Dynamic Worker Management and Remote MCP AI Agent</description>

    <modules>
        <module>common-events</module>
        <module>core-management-service</module>
        <module>worker-manager-service</module>
        <module>analysis-worker</module>
        <module>analytics-results-service</module>
        <module>mcp-agent-service</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <springdoc.openapi.version>2.8.5</springdoc.openapi.version>
        <paho.mqtt.version>1.2.5</paho.mqtt.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>ro.upb.cebp</groupId>
                <artifactId>common-events</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.openapi.version}</version>
            </dependency>
            <dependency>
                <groupId>org.eclipse.paho</groupId>
                <artifactId>org.eclipse.paho.client.mqttv3</artifactId>
                <version>${paho.mqtt.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
